{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CTF Automation Task Schema",
  "description": "基于申报书 1.2.3.1 四层参数模型的工程化实现",
  "type": "object",
  "required": ["task_id", "status", "parameters"], 
  "properties": {
    
    "_comment_engineering": {
      "type": "string",
      "description": "【工程层】以下两个字段是软件运行必须的，虽然申报书未详述，但实际开发不可或缺"
    },
    "task_id": {
      "type": "string",
      "description": "任务唯一标识 (UUID)，用于隔离不同的Docker容器"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "building", "running", "verified", "failed"],
      "description": "任务生命周期状态，用于协调三人模块的执行顺序"
    },

    "_comment_academic": {
      "type": "string",
      "description": "【学术层】以下 parameters 内部严格遵循申报书 1.2.3.1 节定义"
    },
    "parameters": {
      "type": "object",
      "description": "四层参数化对象核心",
      "required": ["system", "challenge", "service", "vulnerability"],
      "properties": {
        
        "system": {
          "type": "object",
          "description": "1. 系统级参数 (System Level)",
          "required": ["network_segment", "log_level"],
          "properties": {
            "network_segment": { "type": "string", "default": "172.20.0.0/16" },
            "log_level": { "type": "string", "enum": ["DEBUG", "INFO", "WARN"] }
          }
        },

        "challenge": {
          "type": "object",
          "description": "2. 题目级参数 (Challenge Level)",
          "required": ["name", "category", "difficulty"],
          "properties": {
            "name": { "type": "string" },
            "category": { "type": "string", "enum": ["Web", "Pwn", "Crypto"] },
            "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
            "description": { "type": "string" },
            "score": { "type": "integer" }
          }
        },

        "service": {
          "type": "object",
          "description": "3. 服务级参数 (Service Level)",
          "required": ["service_name", "docker_template", "exposed_port"],
          "properties": {
            "service_name": { "type": "string" },
            "docker_template": { "type": "string", "description": "对应 templates 目录下的文件夹名" },
            "exposed_port": { "type": "integer" },
            "environment_variables": { "type": "object" }
          }
        },

        "vulnerability": {
          "type": "object",
          "description": "4. 漏洞级参数 (Vulnerability Level)",
          "required": ["vulnerability_type", "flag_location"],
          "properties": {
            "vulnerability_type": { "type": "string" },
            "trigger_condition": { "type": "string" },
            "vulnerable_file": { "type": "string" },
            "flag_location": { "type": "string" },
            "flag_value": { "type": "string", "description": "生成的Flag值" }
          }
        }
      }
    }
  }
}